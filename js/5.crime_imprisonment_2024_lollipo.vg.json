{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Crime Imprisonment Comparison in Australia (2024)",
    "fontSize": 20,
    "anchor": "middle",
    "subtitle": "Number of people imprisoned by crime type - ranked from highest to lowest",
    "subtitleFontSize": 14
  },
  "width": 700,
  "height": 450,
  "data": {
    "url": "../data/crime_imprisonment_2024_lollipop.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#bdc3c7"
      },
      "encoding": {
        "y": {
          "field": "Crime_Type",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "labelFontSize": 13,
            "labelPadding": 10,
            "labelFontWeight": 500
          }
        },
        "x": {
          "field": "Prisoners",
          "type": "quantitative",
          "title": "Number of Prisoners (2024)",
          "scale": {
            "domain": [0, 14000]
          },
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 14,
            "format": ","
          }
        },
        "x2": {
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 350,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "Crime_Type",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Prisoners",
          "type": "quantitative"
        },
        "color": {
          "field": "Crime_Type",
          "type": "nominal",
          "scale": {
            "domain": ["Assault", "Sexual Assault", "Unlawful Entry", "Homicide", "Robbery", "Theft"],
            "range": ["#e74c3c", "#9b59b6", "#3498db", "#34495e", "#e67e22", "#f39c12"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Crime_Type",
            "type": "nominal",
            "title": "Crime Type"
          },
          {
            "field": "Prisoners",
            "type": "quantitative",
            "title": "Prisoners in 2024",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 15,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "Crime_Type",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Prisoners",
          "type": "quantitative"
        },
        "text": {
          "field": "Prisoners",
          "type": "quantitative",
          "format": ","
        },
        "color": {
          "field": "Crime_Type",
          "type": "nominal",
          "scale": {
            "domain": ["Assault", "Sexual Assault", "Unlawful Entry", "Homicide", "Robbery", "Theft"],
            "range": ["#e74c3c", "#9b59b6", "#3498db", "#34495e", "#e67e22", "#f39c12"]
          },
          "legend": null
        }
      }
    }
  ]
}